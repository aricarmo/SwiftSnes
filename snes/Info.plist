<plist version="1.0">
<dict>
	<!-- Mesclado com o Info.plist gerado pelo Xcode (GENERATE_INFOPLIST_FILE).
	     Só as chaves do Sparkle vivem aqui. -->
	<key>SUFeedURL</key>
	<string>https://aricarmo.github.io/SwiftSnes/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>TkKvfJkVfteQRhxZche2b62zWQ/W/KfwPD5YL7FhbfI=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
